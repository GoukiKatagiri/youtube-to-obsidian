#popclip
name: YouTube→Obsidian
icon: symbol:play.rectangle.fill
interpreter: zsh
requirements: [url]
regex: https?://(www\.)?(youtube\.com/(watch|shorts|live)|youtu\.be/)\S+
after: show-status
shell script: |
  LOG_DIR="$HOME/Library/Logs/youtube-to-obsidian"
  [[ -L "$LOG_DIR" ]] && exit 1
  mkdir -p "$LOG_DIR" && chmod 700 "$LOG_DIR"
  "$HOME/.claude/scripts/youtube-to-obsidian.sh" "$POPCLIP_TEXT" >> "$LOG_DIR/youtube-to-obsidian.log" 2>&1 & disown
  exit 0
